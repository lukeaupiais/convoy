{
  "name": "convoy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "check:architecture": "node scripts/check-architecture.mjs",
    "format": "prettier --write apps/web/src packages/contracts/src",
    "format:check": "prettier --check apps/web/src packages/contracts/src",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:worker": "node scripts/build-worker.mjs",
    "test:remote": "node scripts/test-remote-worker.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "server": "node apps/daemon/src/bootstrap/index.mjs",
    "backup": "node scripts/convoy-backup.mjs backup",
    "restore": "node scripts/convoy-backup.mjs restore",
    "migrate:postgres": "node scripts/migrate-persistence.mjs",
    "test": "node --test --test-concurrency=1 tests/*/*.test.mjs",
    "test:acceptance": "node --test --test-concurrency=1 tests/acceptance/*.test.mjs",
    "test:modules": "node --test --test-concurrency=1 tests/modules/*.test.mjs tests/runner/*.test.mjs tests/web/*.test.mjs",
    "attach": "node apps/cli/src/cli.mjs attach",
    "terminal": "node apps/cli/src/cli.mjs terminal",
    "sessions": "node apps/cli/src/cli.mjs sessions",
    "desktop:install": "node node_modules/electron/install.js",
    "desktop:dev": "npm run desktop:install && node scripts/desktop-dev.mjs",
    "desktop": "npm run build && npm run desktop:install && electron .",
    "package:desktop": "npm run build && npm run build:worker && npm run build:worker -- bun-linux-arm64 && npm run desktop:install && electron-builder --publish never"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "vite": "^6.3.5"
  },
  "main": "apps/desktop/main.mjs",
  "description": "Local-first control plane for coding agents.",
  "author": {
    "name": "Luke Aupiais",
    "email": "luke.aupiais@gmail.com"
  },
  "homepage": "https://github.com/lukeaupiais/convoy",
  "repository": {
    "type": "git",
    "url": "https://github.com/lukeaupiais/convoy.git"
  },
  "license": "Apache-2.0",
  "desktopName": "convoy.desktop"
}
